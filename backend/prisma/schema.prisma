generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int            @id @default(autoincrement())
  mobileNumber     String         @unique @map("mobile_number")
  role             UserRole
  isMobileVerified Boolean        @default(true) @map("is_mobile_verified")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  status           UserStatus     @default(ACTIVE)
  disputesRaised   Dispute[]      @relation("disputes_raised")
  employer         Employer?
  notifications    Notification[]
  ratingsGiven     Rating[]       @relation("ratings_given")
  ratingsReceived  Rating[]       @relation("ratings_received")
  worker           Worker?

  @@map("users")
}

model Employer {
  id                 Int       @id @default(autoincrement())
  userId             Int       @unique @map("user_id")
  name               String
  rating             Float     @default(0)
  totalRatings       Int       @default(0) @map("total_ratings")
  totalJobsPosted    Int       @default(0) @map("total_jobs_posted")
  totalJobsCompleted Int       @default(0) @map("total_jobs_completed")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  user               User      @relation(fields: [userId], references: [id])
  jobs               Job[]
  payments           Payment[]
  attendanceDisputes Dispute[]

  @@map("employers")
}

model Worker {
  id                 Int              @id @default(autoincrement())
  userId             Int              @unique @map("user_id")
  name               String
  age                Int
  gender             Gender
  rating             Float            @default(0)
  totalRatings       Int              @default(0) @map("total_ratings")
  totalJobsCompleted Int              @default(0) @map("total_jobs_completed")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  reliabilityScore   Float            @default(100) @map("reliability_score")
  attendance         Attendance[]
  jobApplications    JobApplication[]
  payments           Payment[]
  user               User             @relation(fields: [userId], references: [id])
  attendanceDisputes Dispute[]

  @@map("workers")
}

model Job {
  id                     Int              @id @default(autoincrement())
  employerId             Int              @map("employer_id")
  title                  String
  description            String
  category               String
  wage                   Float
  jobDate                DateTime         @map("job_date")

  expectedStartTime    String    @map("expected_start_time")
  expectedEndTime      String    @map("expected_end_time")
  expectedWorkingHours Float     @default(8) @map("expected_working_hours")

  requiredWorkers        Int              @map("required_workers")
  latitude               Float
  longitude              Float
  status                 JobStatus        @default(OPEN)
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  city                   String?
  landmark               String?
  locationLine1          String?          @map("location_line1")
 
  attendance             Attendance[]
  disputes               Dispute[]
  jobApplications        JobApplication[]
  employer               Employer         @relation(fields: [employerId], references: [id])
  payments               Payment[]
  ratings                Rating[]

  @@map("jobs")
}

model JobApplication {
  id          Int                  @id @default(autoincrement())
  jobId       Int                  @map("job_id")
  workerId    Int                  @map("worker_id")
  status      JobApplicationStatus @default(APPLIED)
  appliedAt   DateTime             @default(now()) @map("applied_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  completedAt DateTime?            @map("completed_at")
  selectedAt  DateTime?            @map("selected_at")
  job         Job                  @relation(fields: [jobId], references: [id])
  worker      Worker               @relation(fields: [workerId], references: [id])

  @@unique([jobId, workerId])
  @@map("job_applications")
}

model Attendance {
  id                Int              @id @default(autoincrement())
  jobId             Int              @map("job_id")
  workerId          Int              @map("worker_id")
  checkInTime       DateTime?        @map("check_in_time")
  checkOutTime      DateTime?        @map("check_out_time")
  totalHours        Float?           @map("total_hours")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  notes             String?
  status            AttendanceStatus @default(CHECKED_IN)
  checkInLatitude   Float?           @map("check_in_latitude")
  checkInLongitude  Float?           @map("check_in_longitude")
  checkOutLatitude  Float?           @map("check_out_latitude")
  checkOutLongitude Float?           @map("check_out_longitude")
  reviewedAt        DateTime?        @map("reviewed_at") @db.Timestamp(6)
  job               Job              @relation(fields: [jobId], references: [id])
  worker            Worker           @relation(fields: [workerId], references: [id])
  disputes          Dispute[]

  @@unique([jobId, workerId])
  @@map("attendance")
}

model Payment {
  id                Int           @id @default(autoincrement())
  jobId             Int           @map("job_id")
  employerId        Int           @map("employer_id")
  workerId          Int           @map("worker_id")
  amount            Float
  status            PaymentStatus @default(PENDING)
  transactionId     String?       @map("transaction_id")
  paidAt            DateTime?     @map("paid_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  employerConfirmed Boolean       @default(false) @map("employer_confirmed")
  workerConfirmed   Boolean       @default(false) @map("worker_confirmed")
  employer          Employer      @relation(fields: [employerId], references: [id])
  job               Job           @relation(fields: [jobId], references: [id])
  worker            Worker        @relation(fields: [workerId], references: [id])

  @@unique([jobId, workerId])
  @@map("payments")
}

model Rating {
  id          Int      @id @default(autoincrement())
  jobId       Int      @map("job_id")
  fromUserId  Int      @map("from_user_id")
  toUserId    Int      @map("to_user_id")
  ratingValue Int      @map("rating_value")
  reviewText  String?  @map("review_text")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  fromUser    User     @relation("ratings_given", fields: [fromUserId], references: [id])
  job         Job      @relation(fields: [jobId], references: [id])
  toUser      User     @relation("ratings_received", fields: [toUserId], references: [id])

  @@unique([jobId, fromUserId, toUserId])
  @@map("ratings")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model Dispute {
  id          Int           @id @default(autoincrement())
  jobId       Int           @map("job_id")
  attendanceId Int?         @map("attendance_id")
  workerId    Int?          @map("worker_id")
  employerId  Int?          @map("employer_id")
  raisedById  Int           @map("raised_by_id")
  reason      String
  description String
  status      DisputeStatus @default(OPEN)
  createdAt   DateTime      @default(now()) @map("created_at")
  job         Job           @relation(fields: [jobId], references: [id])
  attendance  Attendance?   @relation(fields: [attendanceId], references: [id])
  worker      Worker?       @relation(fields: [workerId], references: [id])
  employer    Employer?     @relation(fields: [employerId], references: [id])
  raisedBy    User          @relation("disputes_raised", fields: [raisedById], references: [id])

  @@map("disputes")
}

enum UserRole {
  ADMIN
  EMPLOYER
  WORKER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  TEMP_BLOCKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum JobStatus {
  OPEN
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum JobApplicationStatus {
  APPLIED
  SELECTED
  REJECTED
  COMPLETED
}

enum AttendanceStatus {
  CHECKED_IN
  PENDING_REVIEW
  APPROVED
  ISSUE_REPORTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  DISPUTED
}

enum DisputeStatus {
  OPEN
  RESOLVED
  REJECTED
}
